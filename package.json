{
  "name": "dashboard-kit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build -w @loadsmart/dashboard-kit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx tests/anthropic.test.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "demo": "node scripts/demo.mjs",
    "demo:build": "npm run build && npm run build -w dashboard-kit-demo",
    "test:python": "uv run --project demo/server pytest tests/test_backend.py demo/server/tests -q",
    "test:package": "node --test tests/packaging.test.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run test:python && npm run test:package && npm run demo:build && npm run demo:pages",
    "demo:pages": "npm run build && npm run build:pages -w dashboard-kit-demo"
  },
  "devDependencies": {
    "d3": "^7.9.0",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.11",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/d3": "^7.4.3",
    "@types/react-grid-layout": "^1.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5"
  },
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "node",
    "demo"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
